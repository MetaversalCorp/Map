@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Map links RMAP (its core framework - the former MVMF core plus the
# MVSB / MVRest / MVIO service layers). Whether RMAP was git-built from source or
# supplied via Map_USE_SYSTEM_RMAP, a consumer of the installed Map needs the
# RMAP package on CMAKE_PREFIX_PATH.
find_dependency(RMAP)

# The header-only third-party libraries are linked PUBLIC when supplied via the
# Map_USE_SYSTEM_* options (their imported targets appear in Map's link
# interface), so a consumer must have the same packages available. Guarded so
# this matches how Map was actually built. (The git-fetched copies are added as
# $<BUILD_INTERFACE:> only, so they do not appear in the exported interface.)
if(@Map_USE_SYSTEM_JSON@)
   find_dependency(nlohmann_json 3.11.3)
endif()
if(@Map_USE_SYSTEM_ASIO@)
   find_dependency(asio 1.30.2)
endif()
if(@Map_USE_SYSTEM_WEBSOCKETPP@)
   find_dependency(websocketpp 0.8.2)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/MapTargets.cmake")

check_required_components(Map)
